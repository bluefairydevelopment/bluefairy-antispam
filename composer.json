{
    "name": "bluefairy/bluefairy-antispam",
    "description": "Invisible spam protection for WordPress and WooCommerce — honeypot, time trap, and optional Stop Forum Spam integration.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Blue Fairy Development",
            "homepage": "https://bluefairydevelopment.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^11.2.0",
        "php-stubs/wordpress-stubs": "^6.7",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11",
        "szepeviktor/phpstan-wordpress": "^2",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "BlueFairy\\AntiSpam\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFairy\\AntiSpam\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "lint": [
            "@phpcs",
            "@phpstan"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
